{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "codepulse": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                }
            },
            "root": "",
            "sourceRoot": "src",
            "prefix": "cp",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "outputPath": "dist/codepulse",
                        "index": "src/index.html",
                        "browser": "src/main.ts",
                        "polyfills": [],
                        "tsConfig": "tsconfig.app.json",
                        "inlineStyleLanguage": "scss",
                        "assets": [
                            { "glob": "**/*", "input": "src/assets", "output": "assets" }
                        ],
                        "styles": ["src/styles.scss"],
                        "allowedCommonJsDependencies": ["papaparse"]
                    },
                    "configurations": {
                        "production": {
                            "outputHashing": "all",
                            "budgets": [
                                { "type": "initial", "maximumWarning": "500kB", "maximumError": "1.5MB" },
                                { "type": "anyComponentStyle", "maximumWarning": "10kB", "maximumError": "16kB" }
                            ]
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "configurations": {
                        "production": { "buildTarget": "codepulse:build:production" },
                        "development": { "buildTarget": "codepulse:build:development" }
                    },
                    "defaultConfiguration": "development"
                }
            }
        }
    },
    "cli": {
      "analytics": false
    }
}
