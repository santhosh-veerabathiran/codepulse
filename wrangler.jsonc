{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "codepulse",
    "compatibility_date": "2026-09-25",
    "observability": {
        "enabled": true
    },
    "assets": {
        "directory": "dist/codepulse/browser",
        "not_found_handling": "single-page-application"
    },
    "routes": [{ "pattern": "codepulse.santhosh-veerabathiran.com", "custom_domain": true }]
}
